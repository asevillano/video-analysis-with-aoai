{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location":        { "value": "${AZURE_LOCATION}" },

    "aoaiResourceGroupName": { "value": "${AZURE_OPENAI_RESOURCE_GROUP}" },
    "aoaiAccountName":       { "value": "${AZURE_OPENAI_ACCOUNT_NAME}" },
    "aoaiDeploymentName":    { "value": "${AZURE_OPENAI_DEPLOYMENT_NAME}" },

    "useWhisper":            { "value": "${USE_WHISPER=false}" },
    "whisperEndpoint":       { "value": "${WHISPER_ENDPOINT=}" },
    "whisperDeploymentName": { "value": "${WHISPER_DEPLOYMENT_NAME=}" },
    "whisperApiKey":         { "value": "${WHISPER_API_KEY=}" }
  }
}
